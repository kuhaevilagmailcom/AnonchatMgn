# Токен бота от @BotFather.
# На panel-хостингах переменную могут называть иначе — бот понимает также
# TELEGRAM_BOT_TOKEN / TELEGRAM_TOKEN / BOT_KEY / TOKEN, либо токен вторым аргументом:
#   python main.py <токен>
BOT_TOKEN=

# Через запятую — Telegram ID владельцев. Владельцы имеют все права и могут
# назначать администраторов с ограниченными правами через панель бота.
ADMIN_IDS=

# Куда положить SQLite-файл. Путь должен быть доступен для записи.
DATABASE_PATH=data/anonchat_mgn.db

# Публичный HTTPS-адрес этого же приложения на хостинге.
MINIAPP_ENABLED=true
MINIAPP_URL=
MINIAPP_WEB_DIR=miniapp/web
MINIAPP_HOST=0.0.0.0
MINIAPP_INITDATA_MAX_AGE=3600

# Бренд/город — можно переиспользовать бота для другого города
CITY_NAME=Магнитогорск
CITY_SHORT=МГН
EMOJI_PACK_URL=https://t.me/addemoji/NewsEmoji

# Награда за подписку на канал. Бот должен быть администратором канала.
SUBSCRIPTION_CHANNEL=@anonmgn
SUBSCRIPTION_CHANNEL_URL=https://t.me/anonmgn
SUBSCRIPTION_REWARD=100

# Авто-мут за N жалоб за сутки (0 — выключить)
AUTO_MUTE_REPORTS=3
AUTO_MUTE_MINUTES=60
REPORT_CONTEXT_RETENTION_DAYS=7

# После рестарта не выбрасывать накопившиеся обновления Telegram
DROP_PENDING_UPDATES=false

MESSAGE_RATE_LIMIT=120
MENU_RATE_LIMIT=60

# После /next недавно завершённая пара временно не попадается снова.
RECENT_PARTNER_COOLDOWN_MINUTES=30

DEBUG=false
