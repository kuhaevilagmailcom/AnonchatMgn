# Токен бота от @BotFather.
# На panel-хостингах переменную могут называть иначе — бот понимает также
# TELEGRAM_BOT_TOKEN / TELEGRAM_TOKEN / BOT_KEY / TOKEN, либо токен вторым аргументом:
#   python main.py <токен>
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Через запятую — Telegram ID админов (панель модератора, жалобы, статистика).
# Если переменную не задать, бот считает владельцем id из кода (8464597898) —
# поэтому на хостинге панель работает «из коробки». Свои админы: просто укажи их здесь
# (несколько — через запятую). Нужен форк вообще без админов: ADMIN_IDS=none
ADMIN_IDS=8464597898

# Куда положить SQLite-файл. Если каталог только для чтения, бот сам уйдёт во временную папку.
DB_PATH=data/anonchat_mgn.db

# Бренд/город — можно переиспользовать бота для другого города
CITY_NAME=Магнитогорск
CITY_SHORT=МГН
EMOJI_PACK_URL=https://t.me/addemoji/NewsEmoji

# Авто-мут за N жалоб за сутки (0 — выключить)
AUTO_MUTE_REPORTS=3
AUTO_MUTE_MINUTES=60

DEBUG=false
