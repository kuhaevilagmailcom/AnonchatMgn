# Токен бота от @BotFather.
# На panel-хостингах переменную могут называть иначе — бот понимает также
# TELEGRAM_BOT_TOKEN / TELEGRAM_TOKEN / BOT_KEY / TOKEN, либо токен вторым аргументом:
#   python main.py <токен>
BOT_TOKEN=

# Через запятую — Telegram ID админов (панель модератора, жалобы, статистика).
# Если переменная пустая, бот запускается без администраторов и пишет об этом в лог.
# Несколько id указываются через запятую.
ADMIN_IDS=

# Куда положить SQLite-файл. Путь должен быть доступен для записи.
DATABASE_PATH=data/anonchat_mgn.db

# Бренд/город — можно переиспользовать бота для другого города
CITY_NAME=Магнитогорск
CITY_SHORT=МГН
EMOJI_PACK_URL=https://t.me/addemoji/NewsEmoji

# Авто-мут за N жалоб за сутки (0 — выключить)
AUTO_MUTE_REPORTS=3
AUTO_MUTE_MINUTES=60
REPORT_CONTEXT_RETENTION_DAYS=7

# После рестарта не выбрасывать накопившиеся обновления Telegram
DROP_PENDING_UPDATES=false

MESSAGE_RATE_LIMIT=30
MENU_RATE_LIMIT=12

PREMIUM_PRICE_STARS=129
PREMIUM_DAYS=30

DEBUG=false
